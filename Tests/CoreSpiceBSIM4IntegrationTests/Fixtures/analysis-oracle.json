    "chargeMultiplicityCorrection": {
      "source": "b4ld.c",
      "reason": "Current law mult_i*I and charge law mult_q*Q require matching equivalent RHS and analytic derivatives; original body and physical NQS couplings violate this when factors differ.",
      "expressions": [
        {
          "original": "mult_i * (ceqjd + ceqqjd)",
          "corrected": "mult_i * ceqjd + mult_q * ceqqjd"
        },
        {
          "original": "mult_i * (ceqjs + ceqqjs)",
          "corrected": "mult_i * ceqjs + mult_q * ceqqjs"
        },
        {
          "original": "(*(here->BSIM4DPqPtr) += dxpart * here->BSIM4gtau)",
          "corrected": "(*(here->BSIM4DPqPtr) += mult_q * dxpart * here->BSIM4gtau)"
        },
        {
          "original": "(*(here->BSIM4SPqPtr) += sxpart * here->BSIM4gtau)",
          "corrected": "(*(here->BSIM4SPqPtr) += mult_q * sxpart * here->BSIM4gtau)"
        },
        {
          "original": "(*(here->BSIM4GPqPtr) -= here->BSIM4gtau)",
          "corrected": "(*(here->BSIM4GPqPtr) -= mult_q * here->BSIM4gtau)"
        }
      ],
      "independentCorrectedImplementation": "ngspice-46 b4ld.c SHA256 cdff60297be2153763cdea198a0edda17c60d6cc659a78024b3e1c9eb0a91672"
    }
  },
