{
  "schemaVersion": 1,
  "scope": "CoreSpice supported-subset reliability contract",
  "policy": {
    "oracleOrder": [
      "analytic",
      "live-ngspice",
      "committed-regression-fixture",
      "metamorphic"
    ],
    "highReliabilityRequires": [
      "documented supported domain",
      "independent oracle or metamorphic property",
      "structured failure behavior",
      "reproducible artifact output"
    ],
    "unsupportedBehavior": "unsupported cases must fail loudly or be marked out-of-scope"
  },
  "analyses": [
    {
      "id": "op",
      "status": "supported",
      "primaryRisks": [
        "multiple valid operating points",
        "floating nodes",
        "strong exponential nonlinearities"
      ],
      "requiredGates": [
        "analytic-linear-op",
        "ngspice-nonlinear-op",
        "convergence-stress-op",
        "structured-failure-op"
      ]
    },
    {
      "id": "dc",
      "status": "supported",
      "primaryRisks": [
        "source stepping path dependence",
        "device-region discontinuities",
        "current source sign conventions"
      ],
      "requiredGates": [
        "analytic-dc-sweep",
        "ngspice-dc-sweep",
        "metamorphic-source-scaling",
        "regression-current-source-convention"
      ]
    },
    {
      "id": "ac",
      "status": "supported",
      "primaryRisks": [
        "incorrect operating point linearization",
        "complex solver singularity",
        "dynamic capacitance mismatch"
      ],
      "requiredGates": [
